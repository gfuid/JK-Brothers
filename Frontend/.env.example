# EmailJS Configuration for JK Brothers / ZK Brother
# Get these keys from your EmailJS Dashboard (https://dashboard.emailjs.com/)

# 1. Email Service ID (from Email Services tab, e.g. service_xxxxxxx)
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx

# 2. Email Template ID (from Email Templates tab, e.g. template_xxxxxxx)
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx

# 3. EmailJS Public Key (from Account > API Keys tab, e.g. xxxxxxxxxxxxxxxx)
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY

# 4. Google Sheets Web App URL (from Apps Script > Deploy as Web App)
VITE_GOOGLE_SHEET_WEBAPP_URL=https://script.google.com/macros/s/AKfycb.../exec

